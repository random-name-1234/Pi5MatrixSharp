<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>Pi5MatrixSharp</AssemblyName>
    <RootNamespace>Pi5MatrixSharp</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Pi5MatrixSharp</PackageId>
    <Version>0.2.0</Version>
    <Authors>Alan Smith</Authors>
    <Description>C# bindings and bundled native runtime for driving HUB75 RGB LED matrix panels on Raspberry Pi 5 using Adafruit's Piomatter backend.</Description>
    <PackageTags>raspberry-pi;raspberry-pi-5;hub75;led-matrix;matrix-display;piomatter;csharp;dotnet</PackageTags>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/random-name-1234/Pi5MatrixSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/random-name-1234/Pi5MatrixSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>0.2.0: Brightness control, gamma correction, double buffering, CopyRgba32, thread-safe Show(), chained panel factory, diagnostics, LibraryImport migration, Source Link, and expanded test coverage.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath=""/>
    <Content Include="..\..\runtimes\linux-arm64\native\libpi5matrix.so"
             Link="runtimes/linux-arm64/native/libpi5matrix.so"
             CopyToOutputDirectory="PreserveNewest"
             Pack="true"
             PackagePath="runtimes/linux-arm64/native/"/>
  </ItemGroup>

</Project>
